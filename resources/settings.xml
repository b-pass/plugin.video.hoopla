<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="plugin.video.hoopla">
        <category id="account" label="16000" help="">
            <group id="users">
                <setting id="manage_users" type="action" label="30010" help="30011">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.hoopla/?action=users)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
            </group>
            <group id="playback" label="30001">
                <setting id="force_play" type="boolean" label="30002" help="30003">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
            </group>
            <group id="internal">
                <!-- Written by the addon: a random per-install device id. username, password and authorization
                     (the session token) held the single login of earlier versions; the addon moves them
                     into accounts.json in its userdata and blanks them. -->
                <setting id="username" type="string" help="">
                    <level>4</level>
                    <default/>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <visible>false</visible>
                    <control type="edit" format="string"/>
                </setting>
                <setting id="password" type="string" help="">
                    <level>4</level>
                    <default/>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <visible>false</visible>
                    <control type="edit" format="string"/>
                </setting>
                <setting id="authorization" type="string" help="">
                    <level>4</level>
                    <default/>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <visible>false</visible>
                    <control type="edit" format="string"/>
                </setting>
                <setting id="device_id" type="string" help="">
                    <level>4</level>
                    <default/>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <visible>false</visible>
                    <control type="edit" format="string"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
